{
  "schema-version": 8,
  "switches": {
    "allow-ag": "on",
    "allowed-worker": [
      "external",
      "host"
    ],
    "ask-names": "on",
    "auto-reply": "on",
    "away-gates": "off",
    "cli-provider": "off",
    "completion-cleanup": "off",
    "completion-cleanup-interval-days": 7,
    "git-timeout-ms": 30000,
    "inline-reply": "off",
    "lang": "zh-tw",
    "large-work-minutes": 120,
    "log-verbosity": "all",
    "notebook-ownership": "off",
    "review-policy": "require-independent",
    "streams": "ask",
    "target-doc": ".agentflow/devlog.md",
    "workspace-dir": ".agentflow"
  },
  "pipeline-roles": {
    "requirements": "better",
    "codewalk": "better",
    "explore": "better",
    "spike": "better",
    "spec": "better",
    "implementation": "basic",
    "security-scan": "best",
    "acceptance": "better",
    "cross-check": "better",
    "learn": "basic",
    "threeways": "better"
  },
  "external-workers": [
    {
      "id": "claude-default",
      "command": [
        "claude",
        "-p"
      ],
      "priority": 3,
      "family": "claude",
      "tiers": {
        "best": "claude-opus-5/high",
        "better": "claude-opus-5/medium",
        "basic": "claude-sonnet-5/high",
        "cheap": "haiku/high"
      }
    },
    {
      "id": "codex-default",
      "command": [
        "codex",
        "exec"
      ],
      "priority": 3,
      "family": "codex",
      "tiers": {
        "best": "gpt-5.6-sol/medium",
        "better": "gpt-5.6-terra/high",
        "basic": "gpt-5.6-luna/max",
        "cheap": "gpt-5.4/medium"
      }
    }
  ]
}
